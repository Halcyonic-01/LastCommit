SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Telegram — primary demo channel (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API — test number, 5 verified recipients
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Twilio — trial SMS to verified numbers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sarvam — pre-rendered Kannada audio (Bulbul)
SARVAM_API_KEY=

# Pipeline
PILOT_STATE=karnataka
