# Copy to .env and fill. Never commit .env.

# Supabase — subscribers, rain reports, message + broadcast log. Schema: schema/supabase.sql
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Same project, VITE_-prefixed so the web bundle can read them at build time (Vite only
# exposes VITE_* to client code). Anon key only — never put SUPABASE_SERVICE_KEY here;
# RLS in schema/supabase.sql is what actually limits what the anon key can touch.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Telegram — primary demo channel (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API — test number, 5 verified recipients
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Twilio — trial SMS to verified numbers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sarvam — pre-rendered Kannada audio (Bulbul)
SARVAM_API_KEY=

# Pipeline
PILOT_STATE=karnataka
