# Copy to .env and fill. Never commit .env.

# Supabase — subscribers, rain reports, farmer messages, broadcast + notification log.
# Schema: schema/supabase.sql. The farmer notification page reads farmer_messages with
# the anon key below, so a working Supabase is what actually delivers an advisory.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Same project, VITE_-prefixed so the web bundle can read them at build time (Vite only
# exposes VITE_* to client code). Anon key only — never put SUPABASE_SERVICE_KEY here;
# RLS in schema/supabase.sql is what actually limits what the anon key can touch.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WhatsApp Cloud API — optional legacy.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Neonize Layer (Farmer Voice Assistant & Alerts)
# Backend: 'neonize' (live WhatsApp client) or 'mock' (in-memory simulator for tests)
WHATSAPP_BACKEND=neonize
WHATSAPP_SESSION_PATH=data/whatsapp/session.sqlite3
# Optional phone number for PairPhone code linking (e.g. 919876543210). If empty, shows QR in terminal.
WHATSAPP_PAIR_PHONE=

# Voice Assistant (Sarvam AI / IndicConformer)
# Provider: 'sarvam' (default, primary) or 'indicconformer' (local fallback)
VOICE_PROVIDER=sarvam

# Sarvam AI credentials (required when VOICE_PROVIDER=sarvam)
# Obtain from https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_LANGUAGE=kn-IN
SARVAM_TTS_LANGUAGE=kn-IN
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v4

# Indic Parler-TTS & IndicConformer ASR — local audio servers
# Used when VOICE_PROVIDER=indicconformer or for local offline testing
TTS_SERVER_URL=http://localhost:8765
ASR_SERVER_URL=http://localhost:8766
# Browser-visible equivalents used by the Vite frontend
VITE_TTS_SERVER_URL=http://localhost:8765
VITE_ASR_SERVER_URL=http://localhost:8766

# --- deployment ---------------------------------------------------------------
# Where the browser should reach services/broadcast_server.py. Leave blank for local
# development (defaults to http://localhost:8787). A deployed site MUST set this to the
# server's own HTTPS origin: a page served over HTTPS cannot call a plain-HTTP localhost
# port — the browser blocks it as mixed content, with no useful error.
VITE_BROADCAST_API=

# Server side of the same boundary. A container is handed its port and must listen on
# every interface; a laptop should stay on loopback so its secrets are not exposed to
# the local network. Defaults: 127.0.0.1 and 8787.
BROADCAST_HOST=
# PORT is set by most hosts automatically; only set it to override.
# Comma-separated sites allowed to read this server's responses. Required once deployed:
# the notification endpoints return a farmer's name and their advice, so a wildcard would
# let any site a browser visits read them. Empty = loopback development only.
BROADCAST_ALLOWED_ORIGINS=

# Officer dashboard's send action, via services/broadcast_server.py
# (localhost:8787 — the frontend has no real backend yet). Pick any long random
# string; the officer's browser sends it back with every broadcast request, and a
# request without the matching token is rejected. Without this set, broadcasting
# from the dashboard is refused entirely, on purpose.
OFFICER_BROADCAST_TOKEN=

# Pipeline
PILOT_STATE=karnataka
