# Single .gitignore for the whole project — do not add per-directory ones.
# (.pytest_cache/ writes its own; it is ignored wholesale below.)

# Internal planning doc — stays local, never pushed
IMPLEMENTATION_PLAN.md

# Local editor/tooling config. Named file, not `.claude/` — a CLAUDE.md or a
# project skill added later should still be committable.
.claude/launch.json
# git worktrees for background agents — full nested checkouts, never repo content
.claude/worktrees/

# Bulk + re-downloadable data. scripts/ regenerates all of it in ~22 min.
# Note: `data/raw/*` not `data/raw/` — git cannot un-ignore inside an ignored dir.
data/raw/*
data/interim/*
data/processed/*.parquet
# but the precomputed area-weight matrices ARE inputs the nightly Action needs
!data/processed/weights_*.parquet
# ...as is the frozen climatology + onset bar (280 KB). Without it the Action would need
# the 825 MB IMD archive, which a CI runner does not have.
!data/processed/inference_tables.parquet
# ...as is the ECMWF S2S reforecast (1.7 MB). The XGBoost onset models were fitted with
# these columns, so tests/test_p7_xgb_integration.py needs them to reproduce the shipped
# metrics. Reforecast only — it stops at 2023-09-30 and a live run leaves them NaN.
!data/processed/ecmwf_s2s_features.parquet
# ...as are the frozen XGBoost inference tables exported by scripts/export_xgb_tables.py.
# Without them, live inference falls back to computing climatology and daily features from
# the 57 MB features.parquet and raw indices.
!data/processed/clim_train_only.parquet
!data/processed/extended_daily.parquet

# 1,097 per-area files are a build artifact — regenerated by scripts/split_forecast.py
# so a nightly commit touches 2 files, not 1,097
forecast/area/
*.grd
*.GRD
*.nc

# Tracked: daily EC46 responses, so a demo survives an Open-Meteo outage
!data/cache/
# Audio cache & runtime generated narration audio (never push to git)
data/cache/audio/
web/public/audio/

# Trained models: P6's nightly job does INFERENCE, so the boosters and calibration maps
# have to ship (3.5 MB, changes only on a retrain). metrics.json is tracked too — it is
# the skill claim. Only the heavyweight pickled formats stay out.
models/*.pkl
models/*.joblib
models/*.lgb

# The XGBoost training repo, kept beside this one for provenance. 1.8 GB of its own data
# and venv — only its export bundle belongs here, and that is vendored into models/xgb.
varsha-drishti-model/

# Logs and scratch
logs/
*.log
.ipynb_checkpoints/

# WhatsApp / Neonize session databases
data/whatsapp/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
whatsapp_session*

# Secrets
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Node / web
node_modules/
web/node_modules/
web/dist/
web/.vite/
web/dev-dist/
.vercel/

# photos are served from web/public/photos — CC BY-SA, credited in-app
# .attic holds the full-size originals those .webp files were cut from — kept
# locally for a re-crop, 4 MB of source art git does not need
.attic/

# OS
.DS_Store
