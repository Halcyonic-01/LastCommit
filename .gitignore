# Single .gitignore for the whole project — do not add per-directory ones.
# (.pytest_cache/ writes its own; it is ignored wholesale below.)

# Internal planning doc — stays local, never pushed
IMPLEMENTATION_PLAN.md

# Local editor/tooling config. Named file, not `.claude/` — a CLAUDE.md or a
# project skill added later should still be committable.
.claude/launch.json

# Bulk + re-downloadable data. scripts/ regenerates all of it in ~22 min.
# Note: `data/raw/*` not `data/raw/` — git cannot un-ignore inside an ignored dir.
data/raw/*
data/interim/*
data/processed/*.parquet
data/notifications.json
# but the precomputed area-weight matrices ARE inputs the nightly Action needs
!data/processed/weights_*.parquet

# 1,097 per-area files are a build artifact — regenerated by scripts/split_forecast.py
# so a nightly commit touches 2 files, not 1,097
forecast/area/
*.grd
*.GRD
*.nc

# Tracked: daily EC46 responses, so a demo survives an Open-Meteo outage
!data/cache/

# Trained model binaries (metrics JSON is tracked)
models/*.pkl
models/*.joblib
models/*.lgb

# Logs and scratch
logs/
*.log
.ipynb_checkpoints/

# Secrets
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Node / web
node_modules/
web/node_modules/
web/dist/
web/.vite/
web/dev-dist/
.vercel/

# photos are served from web/public/photos — CC BY-SA, credited in-app
# .attic holds the full-size originals those .webp files were cut from — kept
# locally for a re-crop, 4 MB of source art git does not need
.attic/

# OS
.DS_Store
